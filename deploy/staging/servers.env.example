# Staging topology shared by the four servers. Copy to servers.env, adjust, then run ./generate-env.sh.

# Addresses the servers use to reach each other (IP address or DNS name).
PACS_HOST=10.0.0.11
GATEWAY_HOST=10.0.0.12
DATABASE_HOST=10.0.0.13
STORAGE_HOST=10.0.0.14
RESEARCH_HOST=10.0.0.15

# Parent directory of every data directory (one medical-ai-<component> directory per component).
DATA_ROOT=/data/apps

# Host address on which published ports listen.
BIND_ADDRESS=0.0.0.0

# Published ports.
HTTP_PORT=80
DICOM_PORT=11112
HL7_PORT=2575
AI_RESULTS_PORT=11113
DB_PORT=5432
S3_PORT=8333
ORTHANC_DICOM_PORT=4242
ORTHANC_HTTP_PORT=8042
RESEARCH_HTTP_PORT=8043
MONAI_RESEARCH_PORT=8000

# Calling AE titles allowed to store images to the PACS, separated by spaces.
PACS_ACCEPTED_CALLING_AETS="CT_SCANNER1 DATASET_LOADER"

# Java heap of the archive (WildFly); keep it at about a quarter of the PACS server memory.
ARC_JAVA_HEAP=4g

# Segmentation endpoint of the AI service (NIfTI in, NIfTI mask out); empty disables the AI bridge.
AI_SEGMENT_URL=http://monai:8000/infer/hemorrhage_approved

# REST address of the research Orthanc that receives de-identified CT and AI drafts; empty disables the copies.
RESEARCH_URL=http://10.0.0.15:8043
